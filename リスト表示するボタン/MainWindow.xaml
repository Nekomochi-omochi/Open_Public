<Window x:Class="Boxelle.MainWindow"
        xmlns:local="clr-namespace:Controls.Resizer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Controls"
        xmlns:timer="clr-namespace:Controls.Clock"
        xmlns:memo="clr-namespace:boxelle.Controls.Memo"
        xmlns:todo="clr-namespace:boxelle.Controls.ToDo"
        Title="Boxelle"
        Width="640"
        Height="360"
        MinWidth="320" MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Border
        Background="#F7EEE2"
        Opacity="0.95"
        BorderThickness="1"
        CornerRadius="20"
        Padding="0">

        <Grid>
            <Canvas x:Name="DragCanvas"
                    Background="Transparent">

                <local:ResizableWidgetContainer
                    x:Name="ClockContainer"
                    Width="300"
                    Height="300"
                    MinWidth="160"
                    MinHeight="80"
                    Canvas.Left="10"
                    Canvas.Top="10"
                    MouseLeftButtonDown="Control_MouseLeftButtonDown"
                    MouseMove="Control_MouseMove"
                    MouseLeftButtonUp="Control_MouseLeftButtonUp"
                    ResizeCompleted="WidgetContainer_ResizeCompleted">

                    <local:ResizableWidgetContainer.WidgetContent>
                        <controls:TimeWidget/>
                    </local:ResizableWidgetContainer.WidgetContent>

                </local:ResizableWidgetContainer>

                <local:ResizableWidgetContainer
                    x:Name="TimerContainer"
                    Width="300"
                    Height="300"
                    MinWidth="160"
                    MinHeight="120"
                    Canvas.Left="330"
                    Canvas.Top="10"
                    MouseLeftButtonDown="Control_MouseLeftButtonDown"
                    MouseMove="Control_MouseMove"
                    MouseLeftButtonUp="Control_MouseLeftButtonUp"
                    ResizeCompleted="WidgetContainer_ResizeCompleted">

                    <local:ResizableWidgetContainer.WidgetContent>
                        <timer:TimerWidget/>
                    </local:ResizableWidgetContainer.WidgetContent>

                </local:ResizableWidgetContainer>

                <local:ResizableWidgetContainer
                    x:Name="MemoContainer"
                    MouseLeftButtonDown="Control_MouseLeftButtonDown"
                    MouseMove="Control_MouseMove"
                    MouseLeftButtonUp="Control_MouseLeftButtonUp"
                    ResizeCompleted="WidgetContainer_ResizeCompleted">

                    <local:ResizableWidgetContainer.WidgetContent>
                        <memo:MemoWidget/>
                    </local:ResizableWidgetContainer.WidgetContent>

                </local:ResizableWidgetContainer>

                <local:ResizableWidgetContainer
                    x:Name="TodoContainer"
                    MouseLeftButtonDown="Control_MouseLeftButtonDown"
                    MouseMove="Control_MouseMove"
                    MouseLeftButtonUp="Control_MouseLeftButtonUp"
                    ResizeCompleted="WidgetContainer_ResizeCompleted">

                    <local:ResizableWidgetContainer.WidgetContent>
                        <todo:TodoWidget/>
                    </local:ResizableWidgetContainer.WidgetContent>

                </local:ResizableWidgetContainer>
            </Canvas>

            <Grid>
                <Grid MouseLeave="OnMouseLeaveHandler">
                    <!--検知用Border-->
                    <Border
                        MouseEnter="OnMouseEnterHandler"
                        Name="border1"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        CornerRadius="20"
                        Background="Transparent">

                        <!--操作バー用Border-->
                        <Border
                        Name="border2"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        CornerRadius="20"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Background = "#CCE1D4">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!--最大/最小ボタン-->
                                <Button
                                Click="MaximizeButton_Click"
                                Foreground="#F7EEE2"
                                Content="□"
                                Cursor="Hand"
                                HorizontalAlignment="Right"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0,0,3,0"
                                FocusVisualStyle="{x:Null}">

                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                            x:Name="ButtonBackground"
                                            Background="Transparent"
                                            CornerRadius="20">

                                                <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter
                                                    TargetName="ButtonBackground"
                                                    Property="Background"
                                                    Value="#96BAD7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!--閉じるボタン-->
                                <Button
                                Click="CloseButton_Click"
                                Foreground="#F7EEE2"
                                Content="x"
                                Cursor="Hand"
                                HorizontalAlignment="Right"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                FocusVisualStyle="{x:Null}">

                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                            x:Name="ButtonBackground"
                                            Background="Transparent"
                                            CornerRadius="20">

                                                <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter
                                                    TargetName="ButtonBackground"
                                                    Property="Background"
                                                    Value="#96BAD7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>