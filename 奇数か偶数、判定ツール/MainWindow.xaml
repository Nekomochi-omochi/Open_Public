<Window x:Class="test2_Even_or_Odd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:test2_Even_or_Odd"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="Input_Num"
                 Grid.Row="0"
                 Text=""
                 Width="250"
                 Height="100"
                 Margin ="0,0,0,20"
                 FontSize="60"
                 TextAlignment="Center"
                 VerticalContentAlignment="Center"></TextBox>
        <Button x:Name = "Start_Judgement"
                Grid.Row="1"
                Click="Start_Judgement_Click"
                Width="160"
                Height="80"
                Content="判定"
                Margin ="0,0,0,20"></Button>
        <TextBlock x:Name = "Display_Result"
                   Grid.Row="2"
                   Width="250"
                   Height="100"
                   FontSize="60"
                   TextAlignment="Center"></TextBlock>

    </Grid>
</Window>
